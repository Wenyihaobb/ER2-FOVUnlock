<Project>
  <!--
    Copy this file to "Directory.Build.props" (same folder) and edit the two paths.
    The copy is gitignored so your local paths never end up in the repository.

    GameDir     : the game root folder, the one containing "Easy Red 2.exe"
    InteropDir  : folder with the IL2CPP interop assemblies generated by BepInEx,
                  usually "<GameDir>\BepInEx\interop"
  -->
  <PropertyGroup>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Easy Red 2</GameDir>
    <InteropDir>$(GameDir)\BepInEx\interop</InteropDir>
  </PropertyGroup>
</Project>
